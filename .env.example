# Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model name (optional, default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# VirusTotal API Key (Get from https://www.virustotal.com/)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Clients must send this value in the x-api-key header (leave empty to disable auth)
GUARDRAIL_TOKEN=change_me_to_a_long_random_string

PORT=3000

# Max requests per minute per API key (optional, default: 60, 0 = no limit)
RATE_LIMIT_PER_MINUTE=60

# Incident audit log file (optional, default: audit.jsonl)
AUDIT_LOG_PATH=audit.jsonl
